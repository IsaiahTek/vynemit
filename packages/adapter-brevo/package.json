{
  "name": "@vynelix/vynemit-adapter-brevo",
  "version": "1.0.0",
  "description": "Brevo (formerly Sendinblue) transactional email adapter for Vynemit",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vynemit",
    "adapter",
    "brevo",
    "sendinblue",
    "email",
    "transactional-email",
    "notifications"
  ],
  "author": "Engr., Isaiah Pius E.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaiahTek/vynemit.git",
    "directory": "packages/adapter-brevo"
  },
  "bugs": {
    "url": "https://github.com/IsaiahTek/vynemit/issues"
  },
  "homepage": "https://github.com/IsaiahTek/vynemit#readme",
  "dependencies": {
    "@getbrevo/brevo": "^2.2.0"
  },
  "peerDependencies": {
    "@vynelix/vynemit-core": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "tsup": "^7.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
